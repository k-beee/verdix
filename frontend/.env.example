# Verdix Frontend Environment
# Copy this file to .env.local and fill in the values

# Deployed VerdixCourt contract address on Bradbury testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# GenLayer Bradbury RPC (default, public endpoint)
NEXT_PUBLIC_RPC_URL=https://rpc.bradbury.genlayer.com

# Explorer base URL
NEXT_PUBLIC_EXPLORER_URL=https://explorer-bradbury.genlayer.com
